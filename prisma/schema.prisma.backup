generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model admin {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  admin_level    Int?      @default(1)
  permissions    Json?
  last_activity  DateTime? @db.Timestamp(6)
  is_super_admin Boolean?  @default(false)
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([admin_level], map: "idx_admin_level")
  @@index([user_id], map: "idx_admin_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  address         String
  phone           String?           @db.VarChar(20)
  manager_id      Int?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  is_active       Boolean?          @default(true)
  branchinventory branchinventory[]
  shipments       shipments[]
  staff           staff[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branchinventory {
  id           Int       @id @default(autoincrement())
  branch_id    Int
  product_id   Int
  stock        Int?      @default(0)
  last_updated DateTime? @default(now()) @db.Timestamp(6)
  branches     branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branch_id, product_id], map: "unique_branch_product")
  @@index([branch_id], map: "idx_branchinventory_branch_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(255)
  description String?
  parent_id   Int?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
  products    products[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customers {
  id                Int                 @id @default(autoincrement())
  user_id           Int?                @unique
  dob               DateTime?           @db.Date
  gender            String?             @db.VarChar(10)
  address           String?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  users             users?              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  insuranceclaims   insuranceclaims[]
  notifications     notifications[]
  orders            orders[]
  prescriptions     prescriptions[]
  reviews           reviews[]
  shippingaddresses shippingaddresses[]
  uservouchers      uservouchers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flashsale_products {
  id           Int        @id @default(autoincrement())
  flashsale_id Int
  product_id   Int
  flash_price  Decimal    @db.Decimal(12, 2)
  stock_limit  Int        @default(0)
  sold_count   Int        @default(0)
  created_at   DateTime?  @default(now())
  updated_at   DateTime?  @default(now())
  flashsales   flashsales @relation(fields: [flashsale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([flashsale_id, product_id], map: "unique_flashsale_product")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flashsales {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  description        String?
  start_time         DateTime             @db.Timestamp(6)
  end_time           DateTime             @db.Timestamp(6)
  status             String?              @default("pending") @db.VarChar(50)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  flashsale_products flashsale_products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model insuranceclaims {
  id                Int       @id @default(autoincrement())
  order_id          Int
  product_id        Int
  customer_id       Int
  claim_date        DateTime? @default(now()) @db.Timestamp(6)
  status            String?   @default("submitted") @db.VarChar(50)
  insurance_info    Json?
  provider_response Json?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  customers         customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders            orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products          products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String    @db.VarChar(255)
  details    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model medical_qa {
  id               Int                    @id @default(autoincrement())
  question         String
  answer           String
  url              String?                @db.VarChar(500)
  tags             Json?                  @db.Json
  source           String?                @db.VarChar(500)
  category         String?                @db.VarChar(200)
  disease          String?                @db.VarChar(300)
  specialty        String?                @db.VarChar(200)
  keywords         Json?                  @db.Json
  embedding_google Unsupported("vector")?
  created_at       DateTime?              @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id          Int        @id @default(autoincrement())
  user_id     Int?
  customer_id Int?
  message     String
  type        String?    @db.VarChar(50)
  is_read     Boolean?   @default(false)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  customers   customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order_status_history {
  id         Int       @id @default(autoincrement())
  order_id   Int
  status     String    @db.VarChar(50)
  changed_at DateTime? @default(now()) @db.Timestamp(6)
  changed_by Int?
  users      users?    @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders     orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orderitems {
  id           Int          @id @default(autoincrement())
  order_id     Int
  product_id   Int
  unit_id      Int
  quantity     Int
  price        Decimal      @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  updated_at   DateTime?    @default(now()) @db.Timestamp(6)
  orders       orders       @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products     @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productunits productunits @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_orderitems_order_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id                   Int                    @id @default(autoincrement())
  customer_id          Int
  voucher_id           Int?
  shipping_address_id  Int?
  total_amount         Decimal                @db.Decimal(12, 2)
  discount_amount      Decimal?               @default(0) @db.Decimal(12, 2)
  final_amount         Decimal                @db.Decimal(12, 2)
  status               String?                @default("pending") @db.VarChar(50)
  order_date           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  insuranceclaims      insuranceclaims[]
  order_status_history order_status_history[]
  orderitems           orderitems[]
  customers            customers              @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shippingaddresses    shippingaddresses?     @relation(fields: [shipping_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vouchers             vouchers?              @relation(fields: [voucher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments             payments[]
  prescriptions        prescriptions[]
  shipments            shipments[]
  uservouchers         uservouchers[]

  @@index([customer_id], map: "idx_orders_customer_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  id             Int       @id @default(autoincrement())
  order_id       Int
  payment_method String    @db.VarChar(50)
  amount         Decimal   @db.Decimal(12, 2)
  payment_date   DateTime? @default(now()) @db.Timestamp(6)
  status         String?   @default("pending") @db.VarChar(50)
  transaction_id String?   @unique @db.VarChar(255)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  orders         orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_payments_order_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model prescriptions {
  id                  Int       @id @default(autoincrement())
  customer_id         Int
  order_id            Int?
  prescription_number String?   @unique @db.VarChar(50)
  doctor_name         String?   @db.VarChar(255)
  doctor_license      String?   @db.VarChar(100)
  hospital_name       String?   @db.VarChar(255)
  diagnosis           String?
  prescribed_date     DateTime? @db.Date
  expiry_date         DateTime? @db.Date
  image_url           String?   @db.VarChar(500)
  pdf_url             String?   @db.VarChar(500)
  status              String    @default("pending") @db.VarChar(50)
  verified_by         Int?
  verified_at         DateTime? @db.Timestamp(6)
  verification_notes  String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
  customers           customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  orders              orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction)
  users               users?    @relation(fields: [verified_by], references: [id], onDelete: NoAction)

  @@index([customer_id])
  @@index([order_id])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @db.VarChar(255)
  description           String?
  price                 Decimal                @db.Decimal(12, 2)
  stock                 Int?                   @default(0)
  category_id           Int?
  supplier_id           Int?
  image_url             String?                @db.VarChar(500)
  prescription_required Boolean?               @default(false)
  created_at            DateTime?              @default(now()) @db.Timestamp(6)
  updated_at            DateTime?              @default(now()) @db.Timestamp(6)
  tax_fee               Decimal?               @default(0) @db.Decimal(14, 2)
  base_unit_id          Int?
  images                Json?
  manufacturer          String?
  usage                 String?
  dosage                String?
  specification         String?
  adverseEffect         String?
  registNum             String?
  brand                 String?
  producer              String?
  manufactor            String?
  legalDeclaration      String?
  faq                   Json?
  embedding_google      Unsupported("vector")?
  sold_count            Int                    @default(0)
  branchinventory       branchinventory[]
  flashsale_products    flashsale_products[]
  insuranceclaims       insuranceclaims[]
  orderitems            orderitems[]
  unittype              unittype?              @relation(fields: [base_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories            categories?            @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers             suppliers?             @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productunits          productunits[]
  reviews               reviews[]

  @@index([category_id], map: "idx_products_category_id")
  @@index([supplier_id], map: "idx_products_supplier_id")
  @@index([sold_count])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model productunits {
  id                Int          @id @default(autoincrement())
  product_id        Int
  unit_name         String       @db.VarChar(100)
  conversion_factor Decimal      @db.Decimal(12, 4)
  price             Decimal      @db.Decimal(12, 2)
  created_at        DateTime?    @default(now()) @db.Timestamp(6)
  updated_at        DateTime?    @default(now()) @db.Timestamp(6)
  orderitems        orderitems[]
  products          products     @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reviews {
  id          Int       @id @default(autoincrement())
  customer_id Int
  product_id  Int
  rating      Int
  comment     String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([customer_id, product_id], map: "unique_review")
  @@index([product_id], map: "idx_reviews_product_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model roles {
  id          Int       @id @default(autoincrement())
  role_name   String    @unique @db.VarChar(100)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shipments {
  id                  Int               @id @default(autoincrement())
  order_id            Int
  branch_id           Int
  shipping_address_id Int
  tracking_number     String?           @unique @db.VarChar(100)
  carrier             String?           @db.VarChar(100)
  shipped_date        DateTime?         @db.Timestamp(6)
  estimated_delivery  DateTime?         @db.Timestamp(6)
  actual_delivery     DateTime?         @db.Timestamp(6)
  status              String?           @default("pending") @db.VarChar(50)
  created_at          DateTime?         @default(now()) @db.Timestamp(6)
  updated_at          DateTime?         @default(now()) @db.Timestamp(6)
  branches            branches          @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders              orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shippingaddresses   shippingaddresses @relation(fields: [shipping_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_shipments_order_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shippingaddresses {
  id           Int         @id @default(autoincrement())
  customer_id  Int
  address_line String
  city         String?     @db.VarChar(100)
  state        String?     @db.VarChar(100)
  postal_code  String?     @db.VarChar(20)
  country      String?     @default("Vietnam") @db.VarChar(100)
  is_default   Boolean?    @default(false)
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  updated_at   DateTime?   @default(now()) @db.Timestamp(6)
  orders       orders[]
  shipments    shipments[]
  customers    customers   @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model staff {
  id                Int       @id @default(autoincrement())
  user_id           Int       @unique
  employee_id       String?   @unique @db.VarChar(50)
  branch_id         Int?
  position          String?   @db.VarChar(100)
  department        String?   @db.VarChar(100)
  hire_date         DateTime? @db.Date
  hometown          String?   @db.VarChar(255)
  id_number         String?   @db.VarChar(50)
  emergency_contact String?   @db.VarChar(20)
  emergency_name    String?   @db.VarChar(255)
  salary            Decimal?  @db.Decimal(12, 2)
  bank_account      String?   @db.VarChar(50)
  bank_name         String?   @db.VarChar(100)
  is_active         Boolean?  @default(true)
  notes             String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  branches          branches? @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([branch_id], map: "idx_staff_branch_id")
  @@index([employee_id], map: "idx_staff_employee_id")
  @@index([user_id], map: "idx_staff_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model suppliers {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(255)
  contact_info Json?
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  updated_at   DateTime?  @default(now()) @db.Timestamp(6)
  products     products[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model unittype {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(100)
  products products[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                   Int                    @id @default(autoincrement())
  username             String                 @unique @db.VarChar(255)
  password_hash        String                 @db.VarChar(255)
  email                String                 @unique @db.VarChar(255)
  phone                String?                @unique @db.VarChar(20)
  role_id              Int
  full_name            String?                @db.VarChar(255)
  avatar_url           String?                @db.VarChar(500)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  is_active            Boolean?               @default(true)
  is_verified          Boolean?               @default(false)
  last_login           DateTime?              @db.Timestamp(6)
  admin                admin?
  customers            customers?
  logs                 logs[]
  notifications        notifications[]
  order_status_history order_status_history[]
  prescriptions        prescriptions[]
  staff                staff?
  roles                roles                  @relation(fields: [role_id], references: [id], map: "fk_users_role_id")

  @@index([role_id], map: "idx_users_role_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model uservouchers {
  id          Int       @id @default(autoincrement())
  customer_id Int
  voucher_id  Int
  order_id    Int?
  is_used     Boolean?  @default(false)
  assigned_at DateTime? @default(now()) @db.Timestamp(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders      orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vouchers    vouchers  @relation(fields: [voucher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vouchers {
  id              Int            @id @default(autoincrement())
  code            String         @unique @db.VarChar(50)
  discount_type   String         @db.VarChar(50)
  discount_value  Decimal        @db.Decimal(12, 2)
  min_order_value Decimal?       @db.Decimal(12, 2)
  start_date      DateTime       @db.Date
  end_date        DateTime       @db.Date
  usage_limit     Int?
  used_count      Int?           @default(0)
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  updated_at      DateTime?      @default(now()) @db.Timestamp(6)
  orders          orders[]
  uservouchers    uservouchers[]
}
