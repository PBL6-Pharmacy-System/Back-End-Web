generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admin {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  admin_level    Int?      @default(1)
  permissions    Json?
  last_activity  DateTime? @db.Timestamp(6)
  is_super_admin Boolean?  @default(false)
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([admin_level], map: "idx_admin_level")
  @@index([user_id], map: "idx_admin_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  address              String
  phone                String?                @db.VarChar(20)
  manager_id           Int?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  is_active            Boolean?               @default(true)
  city                 String?                @db.VarChar(100)
  city_id              Int?
  latitude             Decimal?               @db.Decimal(10, 8)
  longitude            Decimal?               @db.Decimal(11, 8)
  cities               cities?                @relation(fields: [city_id], references: [id], map: "fk_branches_city_id")
  branchinventory      branchinventory[]
  inventoryLog         inventoryLog[]
  inventoryReservation inventoryReservation[]
  shipments            shipments[]
  staff                staff[]
  stockTake            stockTake[]
  supplierOrder        supplierOrder[]

  @@index([city], map: "idx_branches_city")
  @@index([city_id], map: "idx_branches_city_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branchinventory {
  id                                                                             Int                 @id @default(autoincrement())
  branch_id                                                                      Int
  product_id                                                                     Int
  stock                                                                          Int?                @default(0)
  last_updated                                                                   DateTime?           @default(now()) @db.Timestamp(6)
  max_stock                                                                      Int?
  min_stock                                                                      Int?
  last_stock_take                                                                DateTime?           @db.Timestamp(6)
  reorder_point                                                                  Int?
  reorder_quantity                                                               Int?
  branches                                                                       branches            @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products                                                                       products            @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventoryLog                                                                   inventoryLog[]
  inventoryTransfer_inventoryTransfer_from_branch_id_product_idTobranchinventory inventoryTransfer[] @relation("inventoryTransfer_from_branch_id_product_idTobranchinventory")
  inventoryTransfer_inventoryTransfer_to_branch_id_product_idTobranchinventory   inventoryTransfer[] @relation("inventoryTransfer_to_branch_id_product_idTobranchinventory")
  productBatch                                                                   productBatch[]
  stockTakeItem                                                                  stockTakeItem[]

  @@unique([branch_id, product_id], map: "unique_branch_product")
  @@index([branch_id], map: "idx_branchinventory_branch_id")
  @@index([stock], map: "idx_branchinventory_stock")
}

