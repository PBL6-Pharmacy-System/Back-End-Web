### ========================================
### QUẢN LÝ TỒN KHO - INVENTORY MANAGEMENT API
### ========================================
### 
### Hướng dẫn sử dụng:
### 1. Chạy lệnh: npx prisma generate
### 2. Đăng nhập và lấy accessToken từ auth.http
### 3. Cập nhật @accessToken ở dưới (CHỈ CẦN 1 TOKEN)
### 4. Cập nhật các ID test theo dữ liệu thực tế trong DB của bạn
### 
### ✅ TẤT CẢ endpoints đã sử dụng {{accessToken}} thống nhất
### 
### ========================================
# Biến cấu hình
@baseUrl = http://localhost:3000/api
@contentType = application/json

# Token xác thực
# Chỉ cần 1 token duy nhất từ response của /auth/login
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjksInVzZXJuYW1lIjoiYWRtaW4xMjMiLCJlbWFpbCI6ImFkbWluMTIzQGdtYWlsLmNvbSIsInJvbGVfaWQiOjEsInJvbGVfbmFtZSI6ImFkbWluIiwiYWRtaW5faWQiOjIsImlzX3N1cGVyX2FkbWluIjpmYWxzZSwiaWF0IjoxNzY2NDEyMzQ4LCJleHAiOjE3NjY0OTg3NDh9.jX4WlfB75CSFuwVVv0NnrwSpXkjGV711wArR6cfSb6g

# ID thử nghiệm (cập nhật theo database thực tế)
@branchId = 2
@productId = 3
@batchId = 711
@transferId = 26
@stockTakeId = 18
@supplierId = 1
@supplierOrderId = 2
@inventoryId = 1824

### ========================================
### TỒN KHO CHI NHÁNH - BRANCH INVENTORY
### ========================================

### Lấy tất cả tồn kho (Admin/Staff)
# Mô tả: Xem danh sách tồn kho của tất cả chi nhánh
# Quyền: Admin (tất cả), Staff (chỉ chi nhánh của mình)
# Response: { success: true, data: [{ id, branch_id, product_id, stock, min_stock, max_stock, ... }] }
GET {{baseUrl}}/branch-inventory
Authorization: Bearer {{accessToken}}

### Lấy tồn kho với bộ lọc
# Mô tả: Lọc tồn kho theo chi nhánh và/hoặc sản phẩm
# Query params: branch_id, product_id
# Response: Danh sách tồn kho đã lọc
GET {{baseUrl}}/branch-inventory?branch_id={{branchId}}&product_id={{productId}}
Authorization: Bearer {{accessToken}}

### Lấy cảnh báo tồn kho thấp
# Mô tả: Xem các sản phẩm có tồn kho dưới ngưỡng tối thiểu
# Response: { success: true, data: [{ product, branch, current_stock, min_stock, shortage }] }
GET {{baseUrl}}/branch-inventory/alerts/low-stock
Authorization: Bearer {{accessToken}}

### Lấy chi tiết tồn kho theo ID
# Mô tả: Xem chi tiết 1 bản ghi tồn kho cụ thể bằng inventory record ID
# Lưu ý: Đây là inventory.id (không phải branch_id)
# Để xem tồn kho theo chi nhánh, dùng: GET /branches/:branchId/inventory
# Response: { success: true, data: { id, branch_id, product_id, stock, ... } }
# TODO: Cập nhật @inventoryId với ID thực tế từ database

GET {{baseUrl}}/branch-inventory/{{inventoryId}}
Authorization: Bearer {{accessToken}}

### Tạo bản ghi tồn kho mới (Chỉ Admin)
# Mô tả: Khởi tạo tồn kho cho sản phẩm tại chi nhánh
# Body: { branch_id, product_id, stock, min_stock, max_stock }
# Response: { success: true, data: { id, ... }, message: "Tạo tồn kho thành công" }
POST {{baseUrl}}/branch-inventory
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "branch_id": {{branchId}},
  "product_id": {{productId}},
  "stock": 100,
  "min_stock": 20,
  "max_stock": 500
}

### Xóa bản ghi tồn kho (Chỉ Admin)
# Mô tả: Xóa hoàn toàn bản ghi tồn kho
# Cảnh báo: Chỉ xóa khi chắc chắn, dữ liệu không thể khôi phục
# Response: { success: true, message: "Xóa tồn kho thành công" }
DELETE {{baseUrl}}/branch-inventory/{{inventoryId}}
Authorization: Bearer {{accessToken}}

### ========================================
### CHI NHÁNH & TỒN KHO - BRANCHES & INVENTORY
### ========================================

### Lấy danh sách tất cả chi nhánh (Public)
# Mô tả: Xem thông tin các chi nhánh (không cần đăng nhập)
# Response: { success: true, data: [{ id, name, address, phone, city, is_active }] }
GET {{baseUrl}}/branches

### Lấy thông tin chi nhánh theo ID (Public)
# Mô tả: Xem chi tiết 1 chi nhánh cụ thể
# Response: { success: true, data: { id, name, address, phone, manager_id, ... } }
GET {{baseUrl}}/branches/{{branchId}}

### Tạo chi nhánh mới (Chỉ Admin)
# Mô tả: Thêm chi nhánh mới vào hệ thống
# Body: { name, address, phone, city, city_id, latitude, longitude }
# Response: { success: true, data: { id, name, ... }, message: "Tạo chi nhánh thành công" }
POST {{baseUrl}}/branches
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Chi nhánh Quận 1",
  "address": "123 Nguyễn Huệ, Quận 1, TP.HCM",
  "phone": "0901234567",
  "city": "Hồ Chí Minh",
  "city_id": 1
}

### Cập nhật thông tin chi nhánh (Chỉ Admin)
# Mô tả: Sửa thông tin chi nhánh đã tồn tại
# Body: Các trường cần cập nhật (name, address, phone, is_active, ...)
# Response: { success: true, data: { updated_branch }, message: "Cập nhật thành công" }
PUT {{baseUrl}}/branches/{{branchId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Chi nhánh Quận 1 - Updated",
  "phone": "0901234568",
  "is_active": true
}

### Xóa chi nhánh (Chỉ Admin)
# Mô tả: Xóa chi nhánh khỏi hệ thống
# Cảnh báo: Không thể xóa nếu còn tồn kho hoặc nhân viên
# Response: { success: true, message: "Xóa chi nhánh thành công" }
DELETE {{baseUrl}}/branches/{{branchId}}
Authorization: Bearer {{accessToken}}

### Xem tồn kho của chi nhánh (Public - dữ liệu bị che)
# Mô tả: Khách hàng chỉ xem được trạng thái còn hàng (in_stock: true/false)
# Response: { success: true, data: [{ product_id, in_stock, product_info }] }
GET {{baseUrl}}/branches/{{branchId}}/inventory

### Xem tồn kho của chi nhánh (Staff - đầy đủ thông tin)
# Mô tả: Staff xem số lượng chính xác, giá nhập, nhà cung cấp
# Response: { success: true, data: [{ product_id, stock, min_stock, max_stock, batches }] }
GET {{baseUrl}}/branches/{{branchId}}/inventory
Authorization: Bearer {{accessToken}}

### Xem chi tiết tồn kho sản phẩm (Public - bị che)
# Mô tả: Xem trạng thái còn hàng của 1 sản phẩm tại chi nhánh
# Response: { success: true, data: { product_id, in_stock, expiry_date_info } }
GET {{baseUrl}}/branches/{{branchId}}/inventory/{{productId}}

### Xem chi tiết lô hàng sản phẩm (Staff - đầy đủ)
# Mô tả: Xem tất cả lô hàng, giá nhập, HSD của sản phẩm
# Response: { success: true, data: { product, batches: [{ batch_number, quantity, expiry_date, cost_price }] } }
GET {{baseUrl}}/branches/{{branchId}}/inventory/{{productId}}
Authorization: Bearer {{accessToken}}

### Cảnh báo lô hàng sắp hết hạn (Staff/Admin)
# Mô tả: Lấy danh sách lô hàng sắp hết hạn trong 30 ngày
# Query: ?days=30 (tùy chỉnh số ngày)
# Response: { success: true, data: [{ batch_number, product, expiry_date, days_until_expiry, quantity }] }
GET {{baseUrl}}/branches/{{branchId}}/inventory/alerts/expiring-soon
Authorization: Bearer {{accessToken}}

### Cảnh báo tồn kho thấp tại chi nhánh (Staff/Admin)
# Mô tả: Sản phẩm có số lượng dưới ngưỡng tối thiểu
# Response: { success: true, data: [{ product, current_stock, min_stock, shortage }] }
GET {{baseUrl}}/branches/{{branchId}}/inventory/alerts/low-stock
Authorization: Bearer {{accessToken}}

### Cập nhật min_stock max_stock thủ công (Staff - chỉ chi nhánh của mình)
# Mô tả: Điều chỉnh số lượng tồn kho tối thiểu và tối đa
# Lưu ý: Staff chỉ được cập nhật chi nhánh mình làm việc, không được chỉnh sửa số lượng tồn kho trực tiếp
# Body: { min_stock, max_stock }
# Response: { success: true, data: { updated_inventory }, message: "Cập nhật tồn kho thành công" }
PUT {{baseUrl}}/branches/{{branchId}}/inventory/{{productId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "min_stock": 25,
  "max_stock": 600
}

### ========================================
### LÔ HÀNG & FEFO - PRODUCT BATCHES (FIRST EXPIRED FIRST OUT)
### ========================================

### Lấy tất cả lô hàng
# Mô tả: Xem danh sách tất cả lô hàng trong hệ thống
# Response: { success: true, data: [{ id, batch_number, product_id, branch_id, quantity, expiry_date, status }] }
GET {{baseUrl}}/product-batches
Authorization: Bearer {{accessToken}}

### Lấy lô hàng với bộ lọc
# Mô tả: Lọc theo chi nhánh, sản phẩm, trạng thái
# Query: branch_id, product_id, status (available/expired/disposed)
# Response: Danh sách lô hàng đã lọc
GET {{baseUrl}}/product-batches?branch_id={{branchId}}&product_id={{productId}}&status=available
Authorization: Bearer {{accessToken}}

### Lấy lô hàng sắp hết hạn
# Mô tả: Danh sách lô hàng hết hạn trong X ngày tới
# Query: days=30 (mặc định 30 ngày)
# Response: { success: true, data: [{ batch_number, product, expiry_date, days_remaining, quantity }] }
GET {{baseUrl}}/product-batches/expiring-soon?days=30
Authorization: Bearer {{accessToken}}

### Lấy lô hàng sắp dụng theo FEFO
# Mô tả: Danh sách lô hàng được sắp xếp theo HSD (hết hạn sớm nhất xuất trước)
# Response: { success: true, data: [{ batch_number, quantity, expiry_date, cost_price }] }
### ========================================
### FEFO (First Expired First Out) - BATCH OPERATIONS
### ========================================

### 📋 STEP 1: Check current batches BEFORE export
# Purpose: Verify current state of batches
# Expected: See all available batches with quantities and expiry dates
GET {{baseUrl}}/product-batches/fefo/{{branchId}}/{{productId}}
Authorization: Bearer {{accessToken}}

### 📋 STEP 2: Preview FEFO allocation plan
# Purpose: See which batches will be used WITHOUT actually exporting
# Expected: Allocation plan showing FEFO order (earliest expiry first)
# Verify:
# - Batches are sorted by expiry_date ASC
# - Quantities allocated correctly
# - Total allocated = requested quantity
POST {{baseUrl}}/product-batches/fefo/allocate
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "branch_id": {{branchId}},
  "product_id": {{productId}},
  "quantity": 100
}

### 🚀 STEP 3: Export stock using FEFO (CRITICAL TEST)
# Purpose: Actually export stock following FEFO strategy
# Expected Response Structure - VERIFY ALL FIELDS:
# {
#   "success": true,
#   "data": {
#     "allocations": [...],  // Before state
#     "logs": [...],         // Audit trail
#     "totalExported": 100,
#     "updatedBatches": [...],  // ⭐ After state
#     "summary": {
#       "total_exported": 100,
#       "batches_used": 2,
#       "branch_id": 2,
#       "branch_name": "...",
#       "product_id": 3,
#       "product_name": "...",
#       "reference_type": "manual_export",
#       "reference_id": null,
#       "exported_at": "...",
#       "exported_by": 9
#     }
#   }
# }
# 
# ✅ VERIFY AFTER RESPONSE:
# 1. allocations[].allocated_qty sum = summary.total_exported
# 2. Each updatedBatches[].quantity = original - allocated_qty
# 3. Logs created for each batch
# 4. summary contains all metadata
POST {{baseUrl}}/product-batches/fefo/export
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "branch_id": {{branchId}},
  "product_id": {{productId}},
  "quantity": 100,
  "reference_type": "manual_export",
  "reference_id": null,
  "note": "Test export FEFO - Verify batch quantities"
}

### ✅ STEP 4: Verify batches after export
# Purpose: Confirm batches have correct remaining quantities
# Expected: 
# - Batches used in export have reduced quantities
# - FEFO order maintained (earliest expiry exported first)
# - If batch quantity = 0, it should still show (not deleted)
GET {{baseUrl}}/product-batches/fefo/{{branchId}}/{{productId}}
Authorization: Bearer {{accessToken}}

### ✅ STEP 5: Check inventory for stock decrease
# Purpose: Verify branchinventory.stock decreased by exported amount
# Expected: stock = previous_stock - 100
GET {{baseUrl}}/branch-inventory?branch_id={{branchId}}&product_id={{productId}}
Authorization: Bearer {{accessToken}}

### ❌ TEST: Invalid reference_type
# Purpose: Test reference_type whitelist validation
# Expected: 400 error - "reference_type không hợp lệ"
# Allowed types: manual_export, order_fulfillment, transfer, damage, sample, return_to_supplier
POST {{baseUrl}}/product-batches/fefo/export
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "branch_id": {{branchId}},
  "product_id": {{productId}},
  "quantity": 10,
  "reference_type": "hacked_type",
  "note": "❌ Should fail - invalid reference_type"
}

### ❌ TEST: Missing reference_id for order_fulfillment
# Purpose: Test conditional validation
# Expected: 400 error - "reference_id (order_id) bắt buộc"
POST {{baseUrl}}/product-batches/fefo/export
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "branch_id": {{branchId}},
  "product_id": {{productId}},
  "quantity": 10,
  "reference_type": "order_fulfillment",
  "reference_id": null,
  "note": "❌ Should fail - missing order_id"
}

### ❌ TEST: Quantity exceeds limit
# Purpose: Test max quantity constraint (100,000)
# Expected: 400 error - "Số lượng xuất vượt quá giới hạn"
POST {{baseUrl}}/product-batches/fefo/export
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "branch_id": {{branchId}},
  "product_id": {{productId}},
  "quantity": 1000000,
  "note": "❌ Should fail - quantity > 100,000"
}

### ❌ TEST: Non-existent branch
# Purpose: Test foreign key validation
# Expected: 404 error - "Chi nhánh không tồn tại"
POST {{baseUrl}}/product-batches/fefo/export
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "branch_id": 99999,
  "product_id": {{productId}},
  "quantity": 10,
  "note": "❌ Should fail - branch doesn't exist"
}

### ========================================
### BATCH IMPORT - CREATE NEW BATCH WITH VALIDATIONS
### ========================================

### 📋 IMPORT STEP 1: Check stock BEFORE import
GET {{baseUrl}}/branch-inventory?branch_id={{branchId}}&product_id={{productId}}
Authorization: Bearer {{accessToken}}

### 🚀 IMPORT STEP 2: Create new batch with all validations
# Purpose: Test complete import flow with all fields
# Verify all data saves correctly
POST {{baseUrl}}/product-batches
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "product_id": {{productId}},
  "branch_id": {{branchId}},
  "batch_number": "TEST-20251222-001",
  "manufacture_date": "2025-01-15",
  "expiry_date": "2027-06-30",
  "quantity": 200,
  "cost_price": 5000,
  "selling_price": 7500,
  "supplier_id": {{supplierId}},
  "note": "Test import - Verify all data"
}

