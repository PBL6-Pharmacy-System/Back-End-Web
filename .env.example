# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pharmacy_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-different-from-jwt-secret"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="*"

# Supabase (nếu sử dụng)
SUPABASE_URL="your-supabase-url"
SUPABASE_KEY="your-supabase-key"

# Cron Jobs
FLASHSALE_CHECK_INTERVAL="*/5 * * * *"
